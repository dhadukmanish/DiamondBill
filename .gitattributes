# Files that run inside Linux containers must keep LF, whatever the checkout OS.
# A CRLF entrypoint fails with "bad interpreter: /bin/sh^M".
*.sh            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
nginx.conf      text eol=lf
docker-compose*.yml text eol=lf
*.sql           text eol=lf
