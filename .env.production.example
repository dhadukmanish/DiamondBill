# Template for /opt/diamondbill/.env on the VPS.
# Never commit the filled-in version — this repo is public.

# Postgres password for the `db` service.   openssl rand -base64 24
POSTGRES_PASSWORD=

# JWT signing secret.                       openssl rand -base64 48
# Changing this logs every user out.
JWT_SECRET=

# Public origin of the app (no trailing slash).
CORS_ORIGIN=https://md.pratishthabridal.in

# Loopback port the host nginx proxies to. Must not clash with anything
# already listening on the VPS (8000 gunicorn, 8080 nginx, 3100 ck, …).
WEB_PORT=8091

# --- first deploy only -------------------------------------------------------
# Creates the tenant + admin user, then set RUN_SEED back to false.
RUN_SEED=false
SEED_TENANT_SLUG=demo
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional
LOG_LEVEL=info
